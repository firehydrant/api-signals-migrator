# Copy this file to config.env and fill in your real keys.
# Do NOT commit real credentials.

# Required for both migrators
FIREHYDRANT_API_KEY=fhb_your_firehydrant_bot_key

# Opsgenie migrator
OPSGENIE_API_KEY=og_your_opsgenie_api_key
OPSGENIE_BASE_URL=https://api.opsgenie.com

# PagerDuty migrator
PAGERDUTY_API_TOKEN=your_pagerduty_api_token
# Optional: leave unset to auto-detect US vs EU host
# PAGERDUTY_BASE_URL=https://api.pagerduty.com

# Optional behavior flags
# PD_ENFORCE_BOUNDARIES=false
# MIGRATOR_CONCURRENCY=16
